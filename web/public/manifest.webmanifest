{
  "name": "delune",
  "short_name": "delune",
  "description": "Find music on Soulseek, check it, and add it to your Navidrome library.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0f1226",
  "theme_color": "#0f1226",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Search", "url": "/", "description": "Find something to listen to" },
    { "name": "Wishlist", "url": "/?wishlist=true", "description": "What delune is watching for" },
    { "name": "Review", "url": "/review", "description": "Downloads waiting to be checked" }
  ]
}
