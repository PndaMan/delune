# Settings for the delune service. After editing: systemctl restart delune
# This file holds passwords; keep it readable by root and delune only.

# Where the web UI listens.
DELUNE_BIND=0.0.0.0:7474

# Your music folder, the one Navidrome scans. The service can write to
# /srv/music by default; for anywhere else, see `systemctl edit delune`.
DELUNE_LIBRARY_DIR=/srv/music

# Soulseek account. A new name is registered the first time it logs in.
DELUNE_SLSK_USERNAME=
DELUNE_SLSK_PASSWORD=
# Port other Soulseek users connect to; forward it on your router.
DELUNE_SLSK_PORT=2234

# Navidrome: sign-in with Navidrome accounts, library checks and rescans.
DELUNE_NAVIDROME_URL=http://localhost:4533
DELUNE_NAVIDROME_USERNAME=
DELUNE_NAVIDROME_PASSWORD=
