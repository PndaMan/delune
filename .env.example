# Soulseek account. A new name is registered the first time it logs in.
DELUNE_SLSK_USERNAME=
DELUNE_SLSK_PASSWORD=

# Navidrome: sign-in with Navidrome accounts, library checks and rescans.
# Use an address the container can reach, such as http://navidrome:4533 on a shared network.
DELUNE_NAVIDROME_URL=
DELUNE_NAVIDROME_USERNAME=
DELUNE_NAVIDROME_PASSWORD=
